#!/usr/bin/env python3

import json
import os
import re
import sys


def fail(message):
    print(message, file=sys.stderr)
    raise SystemExit(1)


try:
    mode = "-t" if "-t" in sys.argv else "-e"
    expression = sys.argv[sys.argv.index(mode) + 1]
except (ValueError, IndexError):
    fail("mock jsonfilter requires -e EXPRESSION")

try:
    document = json.load(sys.stdin)
except ValueError:
    raise SystemExit(126)

if expression == os.environ.get("MOCK_JSONFILTER_FAIL_EXPRESSION"):
    raise SystemExit(126)

fields = document if isinstance(document, dict) else {}
simple = {
    "@": document,
    "@.proto": fields.get("proto"),
    "@.up": fields.get("up"),
    "@.l3_device": fields.get("l3_device"),
    "@.pages": fields.get("pages"),
    "@.id": fields.get("id"),
    "@.name": fields.get("name"),
    "@.type": fields.get("type"),
    "@.target": fields.get("target"),
    "@.ttl_sec": fields.get("ttl_sec"),
    "@.data": fields.get("data"),
    "@.address": fields.get("address"),
    '@["ipv4-address"]': fields.get("ipv4-address"),
    '@["ipv6-address"]': fields.get("ipv6-address"),
}

if expression in simple:
    values = [simple[expression]]
elif expression == '@[*]':
    values = document if isinstance(document, list) else []
elif expression == '@["ipv4-address"][*].address':
    values = [item.get("address") for item in document.get("ipv4-address", [])]
elif expression == '@["ipv6-address"][*].address':
    values = [item.get("address") for item in document.get("ipv6-address", [])]
elif expression == "@.errors[*].reason":
    values = [item.get("reason") for item in document.get("errors", [])]
elif expression == '@.interface[@.proto="pppoe"].interface':
    values = [
        item.get("interface")
        for item in document.get("interface", [])
        if item.get("proto") == "pppoe"
    ]
else:
    match = re.fullmatch(r"@\.data\[(.*)\]\.([A-Za-z0-9_]+)", expression)
    if not match:
        fail(f"unsupported mock jsonfilter expression: {expression}")
    conditions, field = match.groups()
    parsed_conditions = []
    for condition in conditions.split(" && "):
        condition_match = re.fullmatch(
            r'@\.([A-Za-z0-9_]+)=(?:"([^"]*)"|([0-9]+))', condition
        )
        if not condition_match:
            fail(f"unsupported mock jsonfilter condition: {condition}")
        key, string_value, integer_value = condition_match.groups()
        expected = string_value if string_value is not None else int(integer_value)
        parsed_conditions.append((key, expected))
    values = [
        item.get(field)
        for item in document.get("data", [])
        if all(item.get(key) == expected for key, expected in parsed_conditions)
    ]

values = [value for value in values if value is not None]
if not values:
    raise SystemExit(1)

if mode == "-t":
    types = {bool: "boolean", int: "int", float: "double", dict: "object",
             list: "array", str: "string"}
    print("\\ ".join(types[type(value)] for value in values))
    raise SystemExit(0)

for value in values:
    if isinstance(value, (dict, list)):
        print(json.dumps(value))
    elif isinstance(value, bool):
        print("true" if value else "false")
    else:
        print(value)
