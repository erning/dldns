#!/bin/sh

method=GET
data=
url=
while [ "$#" -gt 0 ]; do
	case "$1" in
		--request)
			method=$2
			shift
			;;
		--data)
			data=$2
			shift
			;;
		--config|--connect-timeout|--max-time|--write-out|--header)
			shift
			;;
		https://*) url=$1 ;;
	esac
	shift
done

printf '%s\n' "$method" >>"$MOCK_CURL_LOG"

if [ -n "${MOCK_EXPECT_TTL:-}" ] && [ "$method" != GET ]; then
	case "$data" in
		*\"ttl_sec\":$MOCK_EXPECT_TTL*) ;;
		*)
			printf 'request body does not contain ttl_sec=%s: %s\n' "$MOCK_EXPECT_TTL" "$data" >&2
			exit 2
			;;
	esac
fi

case "$MOCK_SCENARIO:$method" in
	unchanged:GET)
		body='{"data":[{"id":11,"name":"soda.p","type":"A","target":"116.237.37.232","ttl_sec":300}],"pages":1}'
		;;
	unchanged:DELETE)
		body='{}'
		;;
	create:GET)
		body='{"data":[],"pages":1}'
		;;
	create:POST)
		body='{"id":21,"name":"soda.p","type":"A","target":"116.237.37.232","ttl_sec":300}'
		;;
	update:GET)
		body='{"data":[{"id":31,"name":"soda.p","type":"A","target":"116.237.37.1","ttl_sec":300}],"pages":1}'
		;;
	update:PUT)
		body='{"id":31,"name":"soda.p","type":"A","target":"116.237.37.232","ttl_sec":300}'
		;;
	multi6:GET)
		body='{"data":[{"id":61,"name":"soda.p","type":"AAAA","target":"240e::1","ttl_sec":300},{"id":62,"name":"soda.p","type":"AAAA","target":"240e::9","ttl_sec":300},{"id":63,"name":"soda.p","type":"A","target":"198.51.100.9","ttl_sec":300}],"pages":1}'
		;;
	multi6:PUT)
		[ "$url" = 'https://mock.invalid/v4/domains/123/records/62' ] || exit 2
		[ "$data" = '{"name":"soda.p","target":"240e::2","ttl_sec":300}' ] || exit 2
		body='{"id":62,"name":"soda.p","type":"AAAA","target":"240e::2","ttl_sec":300}'
		;;
	reserve_duplicate:GET)
		body='{"data":[{"id":201,"name":"soda.p","type":"A","target":"116.237.37.1","ttl_sec":300},{"id":202,"name":"soda.p","type":"A","target":"116.237.37.1","ttl_sec":300}],"pages":1}'
		;;
	reserve_duplicate:PUT)
		[ "$url" = 'https://mock.invalid/v4/domains/123/records/202' ] || exit 2
		[ "$data" = '{"name":"soda.p","target":"116.237.37.2","ttl_sec":300}' ] || exit 2
		body='{"id":202}'
		;;
	multi6:DELETE)
		body='{}'
		;;
	surplus6:GET)
		body='{"data":[{"id":71,"name":"soda.p","type":"AAAA","target":"240e::1","ttl_sec":300},{"id":72,"name":"soda.p","type":"AAAA","target":"240e::2","ttl_sec":300},{"id":73,"name":"soda.p","type":"AAAA","target":"240e::3","ttl_sec":300}],"pages":1}'
		;;
	surplus6:DELETE)
		body='{}'
		;;
	cname:GET)
		body='{"data":[{"id":81,"name":"soda.p","type":"CNAME","target":"old.example","ttl_sec":300}],"pages":1}'
		;;
	cname:DELETE)
		body='{}'
		;;
	cname:POST)
		body='{"id":82,"name":"soda.p","type":"A","target":"116.237.37.232","ttl_sec":300}'
		;;
	ttl:GET)
		body='{"data":[{"id":91,"name":"soda.p","type":"A","target":"116.237.37.232","ttl_sec":3600}],"pages":1}'
		;;
	ttl:PUT)
		body='{"id":91,"name":"soda.p","type":"A","target":"116.237.37.232","ttl_sec":300}'
		;;
	sync:GET)
		body='{"data":[],"pages":1}'
		;;
	sync:POST)
		body='{"id":101,"ttl_sec":300}'
		;;
	sync_clear4:GET)
		body='{"data":[{"id":104,"name":"soda-v4","type":"A","target":"116.237.37.232","ttl_sec":300}],"pages":1}'
		;;
	sync_clear4:DELETE)
		body='{}'
		;;
	sync_ipv6_only:GET)
		body='{"data":[{"id":105,"name":"soda","type":"A","target":"116.237.37.232","ttl_sec":300}],"pages":1}'
		;;
	sync_ipv6_only:DELETE)
		body='{}'
		;;
	sync_ipv6_only:POST)
		case "$data" in
			*'"type":"AAAA"'*) ;;
			*)
				printf '%s\n' "request body is not for an AAAA record: $data" >&2
				exit 2
				;;
		esac
		body='{"id":102,"ttl_sec":300}'
		;;
	sync_ipv4_only:GET)
		body='{"data":[{"id":106,"name":"soda","type":"AAAA","target":"240e::1","ttl_sec":300}],"pages":1}'
		;;
	sync_ipv4_only:POST)
		case "$data" in
			*'"type":"A"'*) ;;
			*)
				printf '%s\n' "request body is not for an A record: $data" >&2
				exit 2
				;;
		esac
		body='{"id":103,"ttl_sec":300}'
		;;
	sync_ipv4_only:DELETE)
		body='{}'
		;;
	sync_pages:GET)
		case "$url" in
			*'page=1')
				body='{"data":[{"id":107,"name":"soda","type":"A","target":"116.237.37.232","ttl_sec":300},{"id":108,"name":"soda","type":"AAAA","target":"240e:b8f:9b00:8a22::1","ttl_sec":300}],"pages":2}'
				;;
			*'page=2')
				body='{"data":[{"id":109,"name":"soda","type":"AAAA","target":"240e:b8f:9b00:8a22::2","ttl_sec":300}],"pages":2}'
				;;
			*)
				printf '%s\n' "unexpected pagination URL: $url" >&2
				exit 2
				;;
		esac
		;;
	sync_unchanged:GET)
		body='{"data":[{"id":111,"name":"soda","type":"A","target":"116.237.37.232","ttl_sec":300}],"pages":1}'
		;;
	sync_clear6:GET)
		body='{"data":[{"id":121,"name":"soda-v4","type":"A","target":"116.237.37.232","ttl_sec":300},{"id":122,"name":"soda-v4","type":"AAAA","target":"240e::1","ttl_sec":300},{"id":123,"name":"soda-v4","type":"AAAA","target":"240e::2","ttl_sec":300}],"pages":1}'
		;;
	sync_clear6:DELETE)
		body='{}'
		;;
	*)
		printf '%s\n' "unexpected mock request: $MOCK_SCENARIO $method" >&2
		exit 2
		;;
esac

printf '%s\n%s\n' "$body" 200
