#!/bin/sh

if [ "$1" = list ]; then
	[ "${MOCK_UBUS_SCENARIO:-}" != list_error ] || exit 7
	case "${2:-}" in
		'') printf '%s\n' network.interface network.interface.pppoe1 network.interface.pppoe1_6 network.interface.pppoe2 network.interface.pppoe2_6 network.interface.pppoe3 network.interface.standalone_6 ;;
		network.interface.pppoe1_6|network.interface.pppoe2_6) printf '%s\n' "$2" ;;
		*) exit 4 ;;
	esac
	exit 0
fi

[ "$1" = call ] || exit 1

case "${MOCK_UBUS_SCENARIO:-}:$2" in
	canonical_parent_error:network.interface.pppoe2) exit 7 ;;
	ipv6_scope:network.interface.pppoe3)
		printf '%s\n' '{"up":true,"ipv4-address":[{"address":"116.237.37.233"}],"ipv6-address":[{"address":"2::1"},{"address":"20::1"},{"address":"200::1"},{"address":"3::1"},{"address":"1fff::1"},{"address":"2000::1"},{"address":"3FFF::1"},{"address":"4000::1"},{"address":"fe80::1"},{"address":"::1"}]}'
		exit 0
		;;
	equivalent_ipv6:network.interface.pppoe2_6)
		printf '%s\n' '{"up":true,"ipv6-address":[{"address":"240e:b8f:9b00:8a22::1"},{"address":"240E:0B8F:9B00:8A22:0:0:0:1"},{"address":"240e:b8f:9b00:8a22::2"}]}'
		exit 0
		;;
	child_error:network.interface.pppoe2_6|parent_error:network.interface.pppoe2) exit 7 ;;
	all_down:network.interface.pppoe1|all_down:network.interface.pppoe2|all_down:network.interface.pppoe3)
		printf '%s\n' '{"up":false}'
		exit 0
		;;
	parent_down:network.interface.pppoe2)
		printf '%s\n' '{"up":false,"ipv4-address":[{"address":"116.237.37.232"}],"ipv6-address":[{"address":"240e:b8f:9b00:8a22::1"}]}'
		exit 0
		;;
	child_down:network.interface.pppoe2_6|child_down_parent_ipv6:network.interface.pppoe2_6)
		printf '%s\n' '{"up":false,"ipv6-address":[{"address":"240e:b8f:9b00:8a22::2"}]}'
		exit 0
		;;
	child_down_parent_ipv6:network.interface.pppoe2)
		printf '%s\n' '{"up":true,"ipv4-address":[{"address":"116.237.37.232"}],"ipv6-address":[{"address":"240e:b8f:9b00:8a22::1"}]}'
		exit 0
		;;
	parent_unknown:network.interface.pppoe2|child_unknown:network.interface.pppoe2_6)
		printf '%s\n' '{"up":"unknown"}'
		exit 0
		;;
	malformed_child:network.interface.pppoe2_6)
		printf '%s\n' 'not-json'
		exit 0
		;;
	invalid_address:network.interface.pppoe2)
		printf '%s\n' '{"up":true,"ipv4-address":[{"address":"999.1.2.3"}],"ipv6-address":[]}'
		exit 0
		;;
	incomplete_address:network.interface.pppoe2)
		printf '%s\n' '{"up":true,"ipv4-address":[{"address":"116.237.37.232"},{}],"ipv6-address":[]}'
		exit 0
		;;
esac

case "$2:$3" in
	network.interface:dump)
		printf '%s\n' '{"interface":[{"interface":"loopback","proto":"static"},{"interface":"pppoe1","proto":"pppoe"},{"interface":"pppoe2","proto":"pppoe"}]}'
		;;
	network.interface.pppoe1:status)
		printf '%s\n' '{"up":true,"proto":"pppoe","l3_device":"pppoe-pppoe1","ipv4-address":[{"address":"100.100.135.196"}],"ipv6-address":[]}'
		;;
	network.interface.pppoe1_6:status)
		printf '%s\n' '{"up":true,"proto":"dhcpv6","l3_device":"pppoe-pppoe1","ipv4-address":[],"ipv6-address":[{"address":"2409:8a1e:8f01:2a3c::1"}]}'
		;;
	network.interface.pppoe2:status)
		printf '%s\n' '{"up":true,"proto":"pppoe","l3_device":"pppoe-pppoe2","ipv4-address":[{"address":"116.237.37.232"}],"ipv6-address":[]}'
		;;
	network.interface.pppoe2_6:status)
		printf '%s\n' '{"up":true,"proto":"dhcpv6","l3_device":"pppoe-pppoe2","ipv4-address":[],"ipv6-address":[{"address":"240e:b8f:9b00:8a22::1"},{"address":"240e:b8f:9b00:8a22::2"}]}'
		;;
	network.interface.pppoe3:status)
		printf '%s\n' '{"up":true,"proto":"pppoe","l3_device":"pppoe-pppoe3","ipv4-address":[{"address":"116.237.37.233"}],"ipv6-address":[]}'
		;;
	network.interface.standalone_6:status)
		printf '%s\n' '{"up":true,"proto":"dhcpv6","ipv4-address":[],"ipv6-address":[{"address":"240e::1"}]}'
		;;
	*) exit 1 ;;
esac
