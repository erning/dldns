EOF
}

show_sync_help()
{
	cat <<EOF
Usage:
  $PROGRAM_NAME sync [-v|--verbose] [INTERFACE...]

Discover public addresses on selected OpenWrt interfaces and synchronize the
Linode records configured in /etc/config/dldns. Command-line interfaces take
