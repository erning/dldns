#!/bin/sh

# Dynamic DNS helper for OpenWrt.
# No command changes UCI, netifd, routes, cron, or local router state.

PROGRAM_NAME=$(basename "$0")
PROGRAM_VERSION=0.4.0

UBUS_CMD=$DLDNS_UBUS
[ -n "$UBUS_CMD" ] || UBUS_CMD=ubus
JSONFILTER_CMD=$DLDNS_JSONFILTER
[ -n "$JSONFILTER_CMD" ] || JSONFILTER_CMD=jsonfilter
CURL_CMD=$DLDNS_CURL
[ -n "$CURL_CMD" ] || CURL_CMD=curl
JSHN_LIB=$DLDNS_JSHN_LIB
[ -n "$JSHN_LIB" ] || JSHN_LIB=/usr/share/libubox/jshn.sh
UCI_FUNCTIONS_LIB=$DLDNS_UCI_FUNCTIONS_LIB
[ -n "$UCI_FUNCTIONS_LIB" ] || UCI_FUNCTIONS_LIB=/lib/functions.sh

error()
{
	printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
}

sync_verbose()
{
	[ "${SYNC_VERBOSE:-0}" -eq 1 ] || return 0
	printf '%s: %s\n' "$PROGRAM_NAME" "$*"
}

usage_error()
{
	error "$*"
	case "${COMMAND:-}" in
		ip|update|sync)
			printf "Try '%s %s --help' for more information.\n" "$PROGRAM_NAME" "$COMMAND" >&2
			;;
		*)
			printf "Try '%s --help' for more information.\n" "$PROGRAM_NAME" >&2
			;;
	esac
	exit 2
}

show_main_help()
{
	cat <<EOF
Usage: $PROGRAM_NAME COMMAND [options]

Commands:
  ip       Show current interface addresses (read-only)
  update   Reconcile one Linode A and/or AAAA record
  sync     Discover interface addresses and synchronize configured records

Run '$PROGRAM_NAME COMMAND --help' for command-specific help.
EOF
}

show_ip_help()
{
	cat <<EOF
Usage:
  $PROGRAM_NAME ip [options] [INTERFACE...]

Read the current IPv4 and IPv6 addresses of OpenWrt network interfaces.
With no INTERFACE argument, all interfaces using proto=pppoe are discovered.
A PPPoE interface and its generated _6 interface are shown as one WAN.

Options:
  -4, --ipv4             Show IPv4 only
  -6, --ipv6             Show IPv6 only
      --external         Query externally visible addresses (read-only)
      --probe-url URL    Plain-text IP echo endpoint used by --external
